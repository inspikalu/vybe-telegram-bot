# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------

# The port on which your server should run (default is 5000)
PORT=5000

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------

# Telegram Bot Token (from BotFather on Telegram)
# Format: 123456789:ABCdefGhIJKlmNoPQRstuVWXyz
BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------------------------
# Vybe API Integration
# ------------------------------------------------------------------------------

# Your API key to authenticate with Vybe Network's API
VYBE_API_KEY=your_vybe_api_key_here

# Base URL for Vybe Network API (usually doesn't change)
API_BASE_URL=https://api.vybenetwork.xyz

# ------------------------------------------------------------------------------
# Optional: AlphaVybe API Integration
# ------------------------------------------------------------------------------

# (Optional) Your AlphaVybe API key for extra features
ALPHAVYBE_API_KEY=your_alphavybe_api_key_here

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/vybe-bot

# MongoDB database name
MONGODB_DB=vybe-bot

# ------------------------------------------------------------------------------
# Webhook Configuration (Production Only)
# ------------------------------------------------------------------------------

# Public URL for webhook (required in production for Telegram webhooks)
PUBLIC_URL=https://your-public-url.com
